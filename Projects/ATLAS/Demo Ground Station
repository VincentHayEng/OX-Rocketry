#include <WiFi.h>
#include <WebServer.h>
#include <TinyGPSPlus.h>

#define GPS_RX_PIN 17
#define GPS_TX_PIN 16

HardwareSerial GPS(2);
TinyGPSPlus gps;
WebServer server(80);

const char* hotspotName = "HOT_SPOT_NAME";
const char* hotspotPassword = "HOT_SPOT_PASSWORD";

// Simulated rocket last GPS ping
const double rocketLatFixed = 45.417250;
const double rocketLonFixed = -75.698250;

// 70 meters converted to feet
const double rocketAltFixed = 229.66;

const int rocketSatsFixed = 8;

unsigned long lastGpsByteTime = 0;

String twoDigits(int value) {
  if (value < 10) return "0" + String(value);
  return String(value);
}

String uptimeText() {
  unsigned long totalSeconds = millis() / 1000;

  unsigned long hours = totalSeconds / 3600;
  unsigned long minutes = (totalSeconds % 3600) / 60;
  unsigned long seconds = totalSeconds % 60;

  return twoDigits(hours) + ":" + twoDigits(minutes) + ":" + twoDigits(seconds);
}

String groundGpsStatus() {
  if (millis() - lastGpsByteTime > 3000) {
    return "Ground GPS no connection";
  }

  if (!gps.location.isValid()) {
    return "Ground GPS weak";
  }

  int sats = gps.satellites.isValid() ? gps.satellites.value() : 0;

  if (sats >= 6) return "Ground GPS strong";
  if (sats >= 1) return "Ground GPS weak";

  return "Ground GPS no fix";
}

String statusColor() {
  String s = groundGpsStatus();

  if (s == "Ground GPS strong") return "lime";
  if (s == "Ground GPS weak") return "orange";

  return "red";
}

String gpsTimeText() {
  if (!gps.time.isValid()) {
    return "No GPS time";
  }

  String t = "";
  t += twoDigits(gps.time.hour());
  t += ":";
  t += twoDigits(gps.time.minute());
  t += ":";
  t += twoDigits(gps.time.second());
  t += " UTC";

  return t;
}

String dataJson() {
  int groundSats = gps.satellites.isValid() ? gps.satellites.value() : 0;

  String groundLat = gps.location.isValid() ? String(gps.location.lat(), 6) : "null";
  String groundLon = gps.location.isValid() ? String(gps.location.lng(), 6) : "null";
  String groundAlt = gps.altitude.isValid() ? String(gps.altitude.feet(), 2) : "null";

  String json = "{";
  json += "\"status\":\"" + groundGpsStatus() + "\",";
  json += "\"color\":\"" + statusColor() + "\",";
  json += "\"groundSatellites\":" + String(groundSats) + ",";
  json += "\"groundLatitude\":" + groundLat + ",";
  json += "\"groundLongitude\":" + groundLon + ",";
  json += "\"groundAltitude\":" + groundAlt + ",";
  json += "\"rocketSatellites\":" + String(rocketSatsFixed) + ",";
  json += "\"rocketLatitude\":" + String(rocketLatFixed, 6) + ",";
  json += "\"rocketLongitude\":" + String(rocketLonFixed, 6) + ",";
  json += "\"rocketAltitude\":" + String(rocketAltFixed, 2) + ",";
  json += "\"gpsTime\":\"" + gpsTimeText() + "\",";
  json += "\"uptime\":\"" + uptimeText() + "\",";
  json += "\"ip\":\"" + WiFi.localIP().toString() + "\"";
  json += "}";

  return json;
}

void noCache() {
  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Expires", "0");
}

void handleRoot() {
  noCache();

  String page = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
  <title>ATLAS Ground Station</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

  <style>
