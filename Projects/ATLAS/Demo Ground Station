      word-break: break-word;
    }
  </style>
</head>

<body>
  <div id="map"></div>

  <div id="panel">
    <div class="column">
      <div class="title">Rocket / Tracker</div>

      <div class="box">
        <div class="label">Distance To Rocket</div>
        <div class="value" id="distance">Waiting</div>
      </div>

      <div class="box">
        <div class="label">Bearing To Rocket</div>
        <div class="value" id="bearing">Waiting</div>
      </div>

      <div class="box">
        <div class="label">Rocket Satellites</div>
        <div class="value" id="rocketSats">Loading</div>
      </div>

      <div class="box">
        <div class="label">Rocket Altitude</div>
        <div class="value" id="rocketAlt">Loading</div>
      </div>

      <div class="box">
        <div class="label">Rocket Latitude</div>
        <div class="value" id="rocketLat">Loading</div>
      </div>

      <div class="box">
        <div class="label">Rocket Longitude</div>
        <div class="value" id="rocketLon">Loading</div>
      </div>
    </div>

    <div class="column">
      <div class="title">Ground Station</div>

      <div class="box">
        <div class="label">Ground GPS Status</div>
        <div class="value" id="status">Loading</div>
      </div>

      <div class="box">
        <div class="label">Ground Satellites</div>
        <div class="value" id="groundSats">Loading</div>
      </div>

      <div class="box">
        <div class="label">Ground Altitude</div>
        <div class="value" id="groundAlt">Loading</div>
      </div>

      <div class="box">
        <div class="label">Ground Latitude</div>
        <div class="value" id="groundLat">Loading</div>
      </div>

      <div class="box">
        <div class="label">Ground Longitude</div>
        <div class="value" id="groundLon">Loading</div>
      </div>

      <div class="box">
        <div class="label">GPS Time</div>
        <div class="value" id="gpsTime">Loading</div>
      </div>

      <div class="box">
        <div class="label">Time Since Power On</div>
        <div class="value" id="uptime">Loading</div>
      </div>

      <div class="box">
        <div class="label">ESP32 IP</div>
        <div class="value" id="ip">Loading</div>
      </div>
    </div>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    let groundLat = null;
    let groundLon = null;

    let rocketLat = 45.417250;
    let rocketLon = -75.698250;

    let mapHasCentered = false;

    let map = L.map("map").setView([rocketLat, rocketLon], 16);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19
    }).addTo(map);

    let rocketMarker = L.circleMarker([rocketLat, rocketLon], {
      radius: 9,
      color: "red",
      fillColor: "red",
      fillOpacity: 1
    }).addTo(map);

    rocketMarker.bindPopup("Simulated rocket last ping");

    let groundMarker = null;
    let lineToRocket = null;

    function toRad(value) {
      return value * Math.PI / 180;
    }

    function toDeg(value) {
      return value * 180 / Math.PI;
    }

    function bearingToRocket(lat1, lon1, lat2, lon2) {
      let phi1 = toRad(lat1);
      let phi2 = toRad(lat2);
      let deltaLon = toRad(lon2 - lon1);

      let y = Math.sin(deltaLon) * Math.cos(phi2);
      let x = Math.cos(phi1) * Math.sin(phi2) -
              Math.sin(phi1) * Math.cos(phi2) * Math.cos(deltaLon);

      let bearing = toDeg(Math.atan2(y, x));
      bearing = (bearing + 360) % 360;

      return bearing;
    }

    function distanceToRocketMeters(lat1, lon1, lat2, lon2) {
      let earthRadius = 6371000;

      let dLat = toRad(lat2 - lat1);
      let dLon = toRad(lon2 - lon1);

      let a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
              Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
              Math.sin(dLon / 2) * Math.sin(dLon / 2);

      let c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

      return earthRadius * c;
    }

    function updateDistanceAndBearing() {
  if (groundLat === null || groundLon === null) {
    document.getElementById("distance").textContent = "Waiting";
    document.getElementById("bearing").textContent = "Waiting";
    return;
  }

  let bearing = bearingToRocket(groundLat, groundLon, rocketLat, rocketLon);
  let distanceMeters = distanceToRocketMeters(groundLat, groundLon, rocketLat, rocketLon);

  document.getElementById("distance").textContent = distanceMeters.toFixed(1) + " m";
  document.getElementById("bearing").textContent = bearing.toFixed(0) + " deg true";
}

    function showNull(value, decimals, suffix) {
      if (value === null) return "No fix";
      return value.toFixed(decimals) + suffix;
    }

    function updateData() {
      fetch("/data?v=" + Date.now())
        .then(response => response.json())
        .then(data => {
          document.getElementById("status").textContent = data.status;
          document.getElementById("status").style.color = data.color;

          document.getElementById("groundSats").textContent = data.groundSatellites;
          document.getElementById("rocketSats").textContent = data.rocketSatellites;

          document.getElementById("rocketAlt").textContent = data.rocketAltitude.toFixed(2) + " ft";
          document.getElementById("rocketLat").textContent = data.rocketLatitude.toFixed(6);
          document.getElementById("rocketLon").textContent = data.rocketLongitude.toFixed(6);

          document.getElementById("groundAlt").textContent = showNull(data.groundAltitude, 2, " ft");
          document.getElementById("groundLat").textContent = showNull(data.groundLatitude, 6, "");
          document.getElementById("groundLon").textContent = showNull(data.groundLongitude, 6, "");

          document.getElementById("gpsTime").textContent = data.gpsTime;
          document.getElementById("uptime").textContent = data.uptime;
          document.getElementById("ip").textContent = data.ip;

          rocketLat = data.rocketLatitude;
          rocketLon = data.rocketLongitude;

          rocketMarker.setLatLng([rocketLat, rocketLon]);

          if (data.groundLatitude === null || data.groundLongitude === null) {
            groundLat = null;
            groundLon = null;
            updateDistanceAndBearing();
            return;
          }

          groundLat = data.groundLatitude;
          groundLon = data.groundLongitude;

          if (groundMarker === null) {
            groundMarker = L.circleMarker([groundLat, groundLon], {
              radius: 9,
              color: "blue",
              fillColor: "blue",
              fillOpacity: 1
            }).addTo(map);

            groundMarker.bindPopup("Ground station GPS");
          } else {
            groundMarker.setLatLng([groundLat, groundLon]);
          }

          if (lineToRocket === null) {
            lineToRocket = L.polyline([[groundLat, groundLon], [rocketLat, rocketLon]], {
              color: "red",
              weight: 3
            }).addTo(map);
          } else {
            lineToRocket.setLatLngs([[groundLat, groundLon], [rocketLat, rocketLon]]);
          }

          if (!mapHasCentered) {
            map.fitBounds([[groundLat, groundLon], [rocketLat, rocketLon]], {
              padding: [40, 40]
            });
            mapHasCentered = true;
          }

          updateDistanceAndBearing();
        })
        .catch(error => {
          document.getElementById("status").textContent = "ESP32 data error";
          document.getElementById("status").style.color = "red";
        });
    }

    setInterval(updateData, 1000);
    updateData();
  </script>
</body>
</html>
)rawliteral";

  server.send(200, "text/html", page);
}

void handleData() {
  noCache();
  server.send(200, "application/json", dataJson());
}

void connectToHotspot() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(hotspotName, hotspotPassword);

  Serial.println();
  Serial.println("Connecting to phone hotspot...");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("ATLAS ground station connected");
  Serial.print("Open this on your phone: http://");
  Serial.println(WiFi.localIP());
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  GPS.begin(9600, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);

  connectToHotspot();

  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.begin();

  Serial.println("Web server started");
}

void loop() {
  server.handleClient();

  if (WiFi.status() != WL_CONNECTED) {
    connectToHotspot();
  }

  while (GPS.available()) {
    char c = GPS.read();
    gps.encode(c);
    lastGpsByteTime = millis();
    Serial.write(c);
  }
}
